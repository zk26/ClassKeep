<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ikeback" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ikeback_primary</item>
        <item name="colorPrimaryDark">@color/ikeback_primary_dark</item>
        <item name="colorAccent">@color/ikeback_accent</item>
        <item name="colorSurface">@color/ikeback_card</item>
        <item name="android:colorBackground">@color/ikeback_background</item>
        <item name="android:textColorPrimary">@color/ikeback_title</item>
        <item name="android:textColorSecondary">@color/ikeback_body</item>
        <!-- The palette is still light in night mode, so keep dark status icons. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/ikeback_background</item>
    </style>
</resources>
